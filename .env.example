# PostgreSQL
POSTGRES_USER=fastwatch
POSTGRES_PASSWORD=fastwatch_secret
POSTGRES_DB=fastwatch
DATABASE_URL=postgresql+asyncpg://fastwatch:fastwatch_secret@postgres:5432/fastwatch

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# JWT (httpOnly cookies)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_COOKIE_NAME=fastwatch_access_token
COOKIE_SECURE=false
DEFAULT_AVATAR_URL=/static/avatars/default.png

# API / WS ports (host mapping)
API_PORT=8000
WS_PORT=8001

# WS -> API (история, бан в PostgreSQL)
INTERNAL_API_KEY=dev-internal-key
INTERNAL_API_URL=http://api:8000
WS_SESSION_TTL_SECONDS=86400

# Комнаты
MAX_ROOMS_PER_USER=3
ROOM_INACTIVITY_TTL_SECONDS=3600
ROOM_CLEANUP_INTERVAL_SECONDS=300

# Frontend (nginx в Docker)
FRONTEND_PORT=3000

# Глобальные администраторы (username через запятую; назначаются при входе/регистрации и старте API)
GLOBAL_ADMIN_USERNAMES=admin
